# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM845=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# DTBO
# CONFIG_BUILD_ARM64_DT_OVERLAY is not set

# exFAT
CONFIG_EXFAT_FS=y

# EROFS
CONFIG_EROFS_FS=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_SYNAPTICS4302=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y

# Speaker-ID
CONFIG_MFD_SPK_ID=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Touchscreen
CONFIG_TOUCHSCREEN_COMMON=y

# Xiaomi - dipper-q-oss
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y

# CC_WERROR
# CONFIG_CC_WERROR is not set

# ReSukiSU + SUSFS
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y

# TEO idle governor (mainline backport) - auto-selected over menu by rating
CONFIG_CPU_IDLE_GOV_TEO=y

# Non-interactive kconfig choices (avoid syncconfig prompts)
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set

# NoMount
CONFIG_NOMOUNT=y

# TCP congestion control
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_WESTWOOD=y
# CONFIG_DEFAULT_CUBIC is not set
